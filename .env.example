# Any OpenAI-compatible endpoint. Groq is the default; GROQ_API_KEY also works.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# Budget, matching Groq's free tier for gpt-oss-120b.
# Requests are sized and paced so these are never exceeded.
LLM_TPM=8000
LLM_RPM=30
LLM_MAX_REQUEST_TOKENS=7000
